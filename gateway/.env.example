# Copy to .env and replace every placeholder before starting the gateway.
OPENSMS_API_TOKEN=replace-with-a-high-entropy-api-token
OPENSMS_ADMIN_TOKEN=replace-with-a-different-high-entropy-admin-token
OPENSMS_DB_PATH=/app/data/opensms-gateway.sqlite3
OPENSMS_PAIRING_TTL_SECONDS=300
OPENSMS_HEARTBEAT_TIMEOUT_SECONDS=60
OPENSMS_PAIRING_RATE_LIMIT_PER_MINUTE=10
OPENSMS_MESSAGE_RATE_LIMIT_PER_MINUTE=120

# SaaS control plane. Disabled by default so legacy installations remain compatible.
OPENSMS_SAAS_ENABLED=0
OPENSMS_POSTGRES_PASSWORD=replace-with-a-high-entropy-database-password
OPENSMS_SAAS_DATABASE_URL=postgresql+psycopg://opensms:replace-with-url-encoded-password@opensms-postgres:5432/opensms
OPENSMS_SAAS_SESSION_SECRET=replace-with-at-least-32-random-characters
